diff --git a/FrostyModSupport/FileSystemLinker.cs b/FrostyModSupport/FileSystemLinker.cs
new file mode 100644
index 0000000..4058596
--- /dev/null
+++ b/FrostyModSupport/FileSystemLinker.cs
@@ -0,0 +1,63 @@
+using System;
+using System.IO;
+using System.Runtime.InteropServices;
+
+namespace Frosty.ModSupport;
+
+internal static class FileSystemLinker
+{
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool CreateHardLinkW(string newFileName, string existingFileName, IntPtr securityAttributes);
+
+    public static void LinkFile(string destination, string source)
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
+        if (File.Exists(destination))
+        {
+            return;
+        }
+
+        if (OperatingSystem.IsWindows() && CreateHardLinkW(destination, source, IntPtr.Zero))
+        {
+            return;
+        }
+
+        try
+        {
+            File.CreateSymbolicLink(destination, source);
+        }
+        catch (IOException)
+        {
+            File.Copy(source, destination, false);
+        }
+    }
+
+    public static void LinkDirectory(string destination, string source)
+    {
+        if (Directory.Exists(destination))
+        {
+            return;
+        }
+
+        try
+        {
+            Directory.CreateSymbolicLink(destination, source);
+            return;
+        }
+        catch (IOException)
+        {
+            Directory.CreateDirectory(destination);
+        }
+
+        foreach (string directory in Directory.EnumerateDirectories(source, "*", SearchOption.AllDirectories))
+        {
+            Directory.CreateDirectory(Path.Combine(destination, Path.GetRelativePath(source, directory)));
+        }
+
+        foreach (string file in Directory.EnumerateFiles(source, "*", SearchOption.AllDirectories))
+        {
+            LinkFile(Path.Combine(destination, Path.GetRelativePath(source, file)), file);
+        }
+    }
+}
